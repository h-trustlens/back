{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pros",
    "cons",
    "key_opinions"
  ],
  "properties": {
    "pros": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aspect",
          "statement",
          "conditions",
          "members",
          "evidence"
        ],
        "properties": {
          "aspect": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^B\\d+-P\\d+$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^R\\d+\\.\\d+$"
            }
          }
        }
      }
    },
    "cons": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aspect",
          "statement",
          "conditions",
          "members",
          "evidence"
        ],
        "properties": {
          "aspect": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^B\\d+-P\\d+$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^R\\d+\\.\\d+$"
            }
          }
        }
      }
    },
    "key_opinions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aspect",
          "text",
          "stance",
          "members",
          "evidence"
        ],
        "properties": {
          "aspect": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "stance": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "mixed"
            ]
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^B\\d+-P\\d+$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^R\\d+\\.\\d+$"
            }
          }
        }
      }
    }
  }
}
