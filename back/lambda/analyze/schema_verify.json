{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence",
    "exceptions",
    "cards"
  ],
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card",
          "sentence",
          "fits",
          "side"
        ],
        "properties": {
          "card": {
            "type": "string",
            "pattern": "^C\\d+$"
          },
          "sentence": {
            "type": "string",
            "pattern": "^R\\d+\\.\\d+$"
          },
          "fits": {
            "type": "boolean"
          },
          "side": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "mixed"
            ]
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "product_sentences",
          "irony"
        ],
        "properties": {
          "review_id": {
            "type": "string",
            "pattern": "^R\\d+$"
          },
          "product_sentences": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R\\d+\\.\\d+$"
            }
          },
          "irony": {
            "type": "boolean"
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card",
          "statement_ok",
          "conditions_ok"
        ],
        "properties": {
          "card": {
            "type": "string",
            "pattern": "^C\\d+$"
          },
          "statement_ok": {
            "type": "boolean"
          },
          "conditions_ok": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
